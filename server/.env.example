# Local reference only. In production every value is set by Terraform on Cloud Run.
HIRING_ENABLED=false
LEGAL_APPROVED=false
GOOGLE_CLOUD_PROJECT=sprintact-production
CV_BUCKET=stele-bucket-3-sprintact-production
ALLOWED_ORIGIN=https://stele.it.com
# Required decision of the hiring owner: maximum retention for the current selection, in days.
CURRENT_RETENTION_DAYS=
# Optional closing instant, ISO 8601 with timezone. Leave blank until agreed.
DEADLINE=
# Global limit of new applications per Europe/Rome day, persisted in the bucket.
MAX_APPLICATIONS_PER_DAY=
# Secret Manager reference in production (stele-secret-3, numeric version). Never commit a value.
RESEND_API_KEY=
# Sender on the verified Resend domain stele.it.com. Used by applications and the contact form.
NOTIFICATION_FROM="Stele <noreply@stele.it.com>"
NOTIFICATION_TO=info@stele.it.com
